# ===== Portal de Climatizacao - .gitignore =====
# IMPORTANTE: NAO ignorar web/ nem web/data (o portal depende deles).

# backups, temporarios e logs
*.bak
*.tmp
*.log
~$*
.DS_Store

# saidas do servidor de preview (serve.ps1)
_serve_out
_serve_err
_serve_out.log
_serve_err.log

# dependencias / saidas de build
node_modules/
dist/
.cache/

# dados de origem: planilhas .xlsx (fonte externa, grandes; nao versionar)
*.xlsx
_data/

# cache do Python (tools/)
__pycache__/
*.pyc
